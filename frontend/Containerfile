# syntax=docker/dockerfile:1

# ─── Build stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm run build

# ─── Serve stage ─────────────────────────────────────────────────────────────
FROM nginx:stable-alpine AS runner

# OCI image labels
LABEL org.opencontainers.image.title="React App" \
      org.opencontainers.image.description="Vite + React + TypeScript" \
      org.opencontainers.image.base.name="nginx:stable-alpine"

# SPA nginx config (handles client-side routing + security headers + caching)
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

# Health check — works with Docker HEALTHCHECK and Portainer monitoring
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
